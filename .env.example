# ============================================================================
# Intranet Créditos & Cobros · Grupo PDC — Variables de entorno
# Copia este archivo como .env.local (desarrollo) y configúralas en Vercel (producción).
# NUNCA subas .env / .env.local al repositorio.
# ============================================================================

# --- Autenticación del panel administrativo (OBLIGATORIO) ---
# Contraseña de acceso al panel /admin. Usa una contraseña fuerte.
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar la sesión (HMAC). Genera uno con:
#   openssl rand -base64 32
SESSION_SECRET=genera-un-secreto-largo-y-aleatorio

# --- Persistencia con Supabase (OPCIONAL pero recomendado para producción) ---
# Sin estas variables, la intranet funciona en modo semilla (solo lectura).
# Con ellas, el panel guarda cambios de forma permanente.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
